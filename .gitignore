# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds placeholders only and is the documented
# onboarding step ("copy .env.example -> .env.local"). Without this a fresh
# clone never receives it, and the required-secret documentation is invisible.
!.env.example
# ...and SOPS encrypted environment files (encrypted with age public keys)
!.env*.enc
!*.enc.env
!*.enc

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling / setup metadata
*-setup.json
.neon-setup.json

# uploads
/public/uploads/
*.jpg
*.jpeg
*.png
*.gif
*.webp

# local agent / editor config & secrets keys (never commit private keys)
.deepsec/
.mcp.json
.vscode/
.claude/
*.key
*.agekey
keys.txt
key.txt

# scratch work & local API probes
scratch/
*.http

# playwright (tier 5) run artifacts — traces, screenshots and videos are kept
# on failure only, so a green run leaves nothing here
test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
