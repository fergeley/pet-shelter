+
+    expect(wall.BRONZE.map((entry) => entry.name)).toContain("Nurul Aisyah");
+    expect(wall.SILVER.map((entry) => entry.name)).toContain("Jason Lim");
+    expect(wall.GOLD.map((entry) => entry.name)).toContain("Datin Sofia Rahman");
